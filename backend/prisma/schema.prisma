generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id          Int      @id @default(autoincrement())

  fullName    String
  phone       String @unique
  department  String
  year        String

  parentName  String
  parentPhone String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phone])
  @@index([department])
}